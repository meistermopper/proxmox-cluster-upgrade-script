# Proxmox Cluster Upgrade Configuration Example
# Copy this file to config.env and fill in your details.

# List of cluster node IP addresses or hostnames (space-separated)
NODES=("192.168.1.7" "192.168.1.17" "192.168.1.27")

# SSH settings
SSH_USER="root"
SSH_PORT="22"
# Optional SSH key path (leave empty to use default SSH agent / ~/.ssh/id_rsa)
SSH_KEY_PATH=""

# Maintenance & Evacuation settings
# Timeout in seconds to wait for HA guests to evacuate node after enabling maintenance mode
EVACUATION_TIMEOUT=300
# Sleep interval in seconds between evacuation status checks
EVACUATION_CHECK_INTERVAL=10

# Reboot & Quorum settings
# Timeout in seconds to wait for node to reboot and become accessible again
REBOOT_TIMEOUT=600
# Sleep interval in seconds between reboot availability checks
REBOOT_CHECK_INTERVAL=15

# Gotify Notification Settings
# Set GOTIFY_ENABLED to true to enable Gotify notifications
GOTIFY_ENABLED=false
GOTIFY_URL="https://gotify.example.com"
GOTIFY_TOKEN="your_gotify_app_token_here"
GOTIFY_PRIORITY=5

# Telegram Notification Settings
# Set TELEGRAM_ENABLED to true to enable Telegram notifications
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_CHAT_ID="-100123456789"
